# ==============================================================================
# I-CAN PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Integrated Gamified Carbon-Neutral Campus Platform
# Copy this file to .env or .env.local and fill in the corresponding credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & CLIENT ENVIRONMENT (Vite / React 18 PWA)
# ------------------------------------------------------------------------------
VITE_APP_ENV=development                    # development | staging | production
VITE_APP_NAME="I-CAN Platform"
VITE_APP_VERSION=1.0.0
VITE_APP_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:54321/functions/v1

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth GoTrue, Storage, Realtime, Edge Functions)
# ------------------------------------------------------------------------------
# Public / Frontend Client Keys (safe for browser with RLS enabled)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend / Edge Function Keys (RESTRICTED — NEVER EXPOSE TO FRONTEND)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_DB_PASSWORD=your-database-password-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Direct Database Connection Strings (PostgreSQL 15)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Storage Bucket Names
SUPABASE_STORAGE_BUCKET_ACTIONS=action-photos
SUPABASE_STORAGE_BUCKET_AVATARS=user-avatars
SUPABASE_STORAGE_BUCKET_BADGES=badge-icons

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE EDGE INFRASTRUCTURE (Workers, Workers AI, R2 & KV)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# Cloudflare Workers AI & Gateway
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/your-account-id/ican-gateway
CLOUDFLARE_AI_MODEL_RESNET=@cf/microsoft/resnet-50
CLOUDFLARE_AI_MODEL_ANOMALY=@cf/meta/llama-guard-3-8b

# Cloudflare R2 Object Storage (Cold Backup / Egress Optimization)
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=ican-media-backup
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media-cdn.ican.binus.ac.id

# Cloudflare KV (Emission Factor & Cache Namespaces)
CLOUDFLARE_KV_EMISSION_FACTORS_ID=your-kv-emission-namespace-id
CLOUDFLARE_KV_CACHE_ID=your-kv-cache-namespace-id

# ------------------------------------------------------------------------------
# 4. INTELLIGENCE & FALLBACK AI SERVICES
# ------------------------------------------------------------------------------
# Google Gemini API (Free Tier Fallback / Descriptive AI Verification)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter (Optional Secondary Fallback)
OPENROUTER_API_KEY=your-openrouter-api-key

# ------------------------------------------------------------------------------
# 5. CAMPUS & EXTERNAL API INTEGRATIONS
# ------------------------------------------------------------------------------
# myBINUS Integration (SSO OAuth2 & SAT Point Synchronization)
MYBINUS_SSO_AUTH_URL=https://mybinus.binus.ac.id/oauth/authorize
MYBINUS_SSO_TOKEN_URL=https://mybinus.binus.ac.id/oauth/token
MYBINUS_API_BASE_URL=https://api.mybinus.binus.ac.id/v1
MYBINUS_CLIENT_ID=your-mybinus-client-id
MYBINUS_CLIENT_SECRET=your-mybinus-client-secret
MYBINUS_API_KEY=your-mybinus-api-key

# Teach For Indonesia (TFI) / Comserv Log Integration
TFI_APPS_API_BASE_URL=https://api.tfi.binus.edu/v1
TFI_APPS_API_KEY=your-tfi-api-key

# Map & Geocoding Services (MapLibre / Google Maps fallback)
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT="mailto:admin@ican.binus.ac.id"

# ------------------------------------------------------------------------------
# 7. MONITORING, LOGGING & ANALYTICS
# ------------------------------------------------------------------------------
LOGFLARE_API_KEY=your-logflare-api-key
LOGFLARE_SOURCE_ID=your-logflare-source-id
VITE_SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# ------------------------------------------------------------------------------
# 8. CI/CD & DEPLOYMENT SECRETS (GitHub Actions / Vercel)
# ------------------------------------------------------------------------------
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id
