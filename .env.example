# ==============================================================================
# I-CAN PLATFORM — LEAN MVP CONFIGURATION (.env)
# Ultra-lightweight setup for ~20 users/day pilot test
# ==============================================================================

# 1. Frontend Client Configuration (Vite / Netlify)
VITE_APP_NAME="I-CAN Campus"
VITE_APP_VERSION="1.0.0"

# 2. Supabase (Database, Auth, Storage)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Logto Authentication & SSO (Logto Cloud / Self-Hosted OIDC Provider)
# Dapatkan dari: Logto Cloud Console (https://cloud.logto.io) -> Applications -> Create Single Page App
# Redirect URI wajib didaftarkan di Logto: https://<domain-anda>/callback (atau http://localhost:5173/callback)
# Post Sign-out Redirect URI: https://<domain-anda>/login (atau http://localhost:5173/login)
VITE_LOGTO_ENDPOINT=https://your-logto-tenant.logto.app/
VITE_LOGTO_APP_ID=your-logto-app-id-here

# 4. AI Verification (Google Gemini 1.5 Flash - Free Tier)
# Dapatkan gratis dari Google AI Studio (aistudio.google.com)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# 5. Campus Integration Mode
# Biarkan 'true' untuk mode demo/pilot tanpa birokrasi IT kampus
VITE_USE_MOCK_CAMPUS=true
