# ==============================================================================
# I-CAN PLATFORM — LEAN MVP CONFIGURATION (.env)
# Ultra-lightweight setup for ~20 users/day pilot test & judging demo
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Client & Deployment Mode Configuration
# ------------------------------------------------------------------------------
VITE_APP_NAME="I-CAN Campus"
VITE_APP_VERSION="1.0.0"

# Application Mode:
# 'production' = Prototype End-User Mode (Strict role access, clean student experience)
# 'demo'       = Dev / Jury Showcase Mode (1-Click role switcher & shortcuts enabled)
VITE_APP_MODE=demo

# ------------------------------------------------------------------------------
# 2. Multimodal Vision AI Model Routing & Fallback System
# Provider options: 'auto' | 'openrouter' | 'nvidia_nim' | 'gemini'
# If set to 'auto', system automatically selects available configured provider with fallback.
# ------------------------------------------------------------------------------
VITE_AI_PROVIDER=auto

# [Opsi A] OpenRouter Routing (Multi-Model Hub: Llama 3.2 Vision, Gemini 1.5, Qwen 2 VL)
# Dapatkan API Key di: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
VITE_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# Rekomendasi Model Vision:
# - 'meta-llama/llama-3.2-11b-vision-instruct:free' (Free Tier)
# - 'google/gemini-flash-1.5'
# - 'qwen/qwen-2-vl-72b-instruct'
VITE_OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# [Opsi B] NVIDIA NIM Routing (NVIDIA Inference Microservices)
# Dapatkan API Key di: https://build.nvidia.com/ (1000 free credits)
VITE_NVIDIA_NIM_API_KEY=nvapi-your-nvidia-nim-key-here
VITE_NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
# Rekomendasi Model NIM Vision:
# - 'meta/llama-3.2-11b-vision-instruct'
# - 'meta/llama-3.2-90b-vision-instruct'
# - 'nvidia/neva-22b'
VITE_NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# [Opsi C] Google AI Studio / Gemini Routing
# Dapatkan API Key gratis di: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 3. Supabase (PostgreSQL Database, Row Level Security, Storage)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 4. Logto Authentication & SSO (Logto Cloud / Self-Hosted OIDC Provider)
# Dapatkan dari: Logto Cloud Console (https://cloud.logto.io) -> Applications -> SPA
# ------------------------------------------------------------------------------
VITE_LOGTO_ENDPOINT=https://your-logto-tenant.logto.app/
VITE_LOGTO_APP_ID=your-logto-app-id-here

# ------------------------------------------------------------------------------
# 5. Campus Integration Mode
# Biarkan 'true' untuk mode demo/pilot tanpa ketergantungan birokrasi IT kampus
# ------------------------------------------------------------------------------
VITE_USE_MOCK_CAMPUS=true
